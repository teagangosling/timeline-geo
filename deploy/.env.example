# Copy to deploy/.env and fill in. Never commit the filled-in file.
#
# Only the variables this fork adds or that differ from upstream are documented
# here in detail; see ../.env.example for the full upstream reference.

# ---------------------------------------------------------------- database ---
GEOPULSE_POSTGRES_HOST=geopulse-postgres
GEOPULSE_POSTGRES_PORT=5432
GEOPULSE_POSTGRES_DB=geopulse
GEOPULSE_POSTGRES_USERNAME=geopulse-user
GEOPULSE_POSTGRES_PASSWORD=

# SELECT-only role used exclusively by public-app. Created by
# db/grants-public-ro.sql, which must be re-run after every Flyway migration
# because Flyway runs as the read-write user above and new tables are not
# granted by default (deliberately - see that file).
GEOPULSE_POSTGRES_RO_USER=geopulse_ro
GEOPULSE_POSTGRES_RO_PASSWORD=

# ------------------------------------------------------------ google places ---
# Places API (New) key, used to turn Google Timeline placeIDs into real POI
# names. Kept as an env var rather than a system_settings row because that
# table is admin-panel editable and is carried in every database dump.
# Leave blank to disable; the geocoder chain then names every stay.
GEOPULSE_GOOGLE_PLACES_API_KEY=

# Must be true for placeID-based naming to run at all - the code defaults it to
# false because each uncached lookup is billable. With a migrated place-name
# cache almost every lookup is a cache hit, so the real cost is near zero.
GEOPULSE_GOOGLE_PLACES_ENABLED=true

# --------------------------------------------------------------- public app ---
# GeoPulse is multi-user. Every public query is scoped to this single user id.
# Find it with: SELECT id, email FROM users;
PUBLIC_USER_ID=

# Metres trimmed from each end of every published trip line, so shared geometry
# never starts or ends at a doorstep. The retired app published untrimmed lines.
PUBLIC_TRIP_CLIP_M=500

# Radius blanked out around every favorite location (Home, Work, ...) in
# published trip geometry. Clipping the ends is not enough on its own: idling
# near home adds path length without distance, and drive-by trips have no
# endpoint to trim. 0 disables redaction.
PUBLIC_REDACT_M=500

TILE_STYLE_URL=

# ------------------------------------------------------------------- deploy ---
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_UID=1000
DEPLOY_WEBHOOK_GID=1000
# Host's docker group id: getent group docker | cut -d: -f3
DOCKER_SOCK_GID=110
DEPLOY_WEBHOOK_SSH_DIR=./deploy-webhook-ssh

# ------------------------------------------------------------------ upstream ---
GEOPULSE_UI_URL=
GEOPULSE_PUBLIC_BASE_URL=
GEOPULSE_BACKEND_URL=http://geopulse-backend:8080
GEOPULSE_COOKIE_DOMAIN=""
GEOPULSE_AUTH_SECURE_COOKIES=true
GEOPULSE_ADMIN_EMAIL=
GEOPULSE_USER_DEFAULT_MEASURE_UNIT=METRIC
GEOPULSE_IMPORT_TRANSACTION_TIMEOUT_MINUTES=1440
CLIENT_MAX_BODY_SIZE=1000M
